{
  "name": "@clycites/kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "migrate": "tsx src/storage/migrate-cli.ts",
    "openapi": "tsx src/api/openapi-cli.ts",
    "docs:reference": "tsx scripts/generate-docs-reference.ts",
    "seed": "tsx src/seed/cli.ts",
    "seed:reset": "tsx src/seed/reset-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@clycites/schema": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@readme/openapi-parser": "^6.3.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2"
  }
}
