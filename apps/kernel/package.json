{
  "name": "@clycites/kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "migrate": "tsx src/storage/migrate-cli.ts",
    "openapi": "tsx src/api/openapi-cli.ts"
  },
  "dependencies": {
    "@clycites/schema": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.4",
    "typescript": "^7.0.2"
  }
}
