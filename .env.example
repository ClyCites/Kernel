# The kernel's own connection. This role holds INSERT and SELECT on record
# tables and nothing else — see docs/decisions/0001-append-only-enforcement.md.
DATABASE_URL=postgres://kernel_app:kernel_app_dev_only@localhost:5433/clycites

# The migration connection. Owns the schemas and is the only role that can
# perform DDL. Never used to serve requests.
MIGRATOR_DATABASE_URL=postgres://clycites_owner:clycites_owner_dev_only@localhost:5433/clycites

# Password granted to kernel_app when migration 0001 provisions the role.
KERNEL_APP_PASSWORD=kernel_app_dev_only

# How many months of partitions `pnpm migrate` provisions ahead of today.
PARTITION_MONTHS_AHEAD=24

# Spec §9.1. Unexplained shrinkage above this fraction of a lot's opening weight
# is surfaced on the lot's balance. 0.02 is a placeholder — roughly the moisture
# loss a coop would not remark on — and stays one until §13 field validation
# produces a real number.
MASS_BALANCE_TOLERANCE=0.02

# Whether this instance accepts writes tagged `dataset: seed`. Off means the
# x-clycites-dataset header is ignored outright, so a production instance cannot
# be poisoned with fabricated records. Turn it on for a seeded demo or a staging
# environment and nowhere else. Only the literal `true` enables it.
SEED_INGEST_ENABLED=false

# Read for one purpose only: `production` together with SEED_INGEST_ENABLED=true
# is refused at startup. Nothing else branches on it.
NODE_ENV=development

# Requests per window per address against /v1/registry — the only surface with
# no authenticated caller behind it (docs/decisions/0024). The rows are
# immutable and served with a day-long Cache-Control, so a consumer that caches
# will never see this. Counted in this process, so it is per replica and resets
# on deploy: a real limit belongs at the gateway.
REGISTRY_RATE_LIMIT=600
REGISTRY_RATE_WINDOW_SECONDS=60

# Where the audit log is copied to, off this box (docs/decisions/0025). The
# database copy is the statutory record and is written synchronously; this is
# the tamper-evidence copy, and its value is that it sits somewhere an operator
# with credentials to this database cannot reach. Empty means it is not copied
# anywhere, which is a supported configuration and a weaker one.
#
# Shipping is best effort by design and can never fail a request. AUDIT_SHIP_TOKEN
# is a secret: set it in the environment, never here.
AUDIT_SHIP_URL=
AUDIT_SHIP_TOKEN=
AUDIT_SHIP_INTERVAL_SECONDS=10
AUDIT_SHIP_BATCH=200

# The whole s.9 question, as one boolean (docs/decisions/0029-consent.md).
#
# s.9(1) makes financial information special personal data. s.9(3)(c) exempts a
# body relating to individuals who are its members, provided nothing goes to a
# third party without consent. Whether that reaches a cooperative processing its
# members' prices is a question for counsel.
#
# true  — member-body access to a priced Delivery, Obligation or
#         SettlementReference additionally requires a consent grant.
# false — membership alone suffices.
#
# FAIL CLOSED. Leave it true until there is a written answer. Non-financial
# records are unaffected either way.
S9_CONSENT_REQUIRED_FOR_MEMBER_BODY=true

PORT=3000
LOG_LEVEL=info
