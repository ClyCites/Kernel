# The kernel's own connection. This role holds INSERT and SELECT on record
# tables and nothing else — see docs/decisions/0001-append-only-enforcement.md.
DATABASE_URL=postgres://kernel_app:kernel_app_dev_only@localhost:5433/clycites

# The migration connection. Owns the schemas and is the only role that can
# perform DDL. Never used to serve requests.
MIGRATOR_DATABASE_URL=postgres://clycites_owner:clycites_owner_dev_only@localhost:5433/clycites

# Password granted to kernel_app when migration 0001 provisions the role.
KERNEL_APP_PASSWORD=kernel_app_dev_only

# How many months of partitions `pnpm migrate` provisions ahead of today.
PARTITION_MONTHS_AHEAD=24

# Spec §9.1. Unexplained shrinkage above this fraction of a lot's opening weight
# is surfaced on the lot's balance. 0.02 is a placeholder — roughly the moisture
# loss a coop would not remark on — and stays one until §13 field validation
# produces a real number.
MASS_BALANCE_TOLERANCE=0.02

# Whether this instance accepts writes tagged `dataset: seed`. Off means the
# x-clycites-dataset header is ignored outright, so a production instance cannot
# be poisoned with fabricated records. Turn it on for a seeded demo or a staging
# environment and nowhere else. Only the literal `true` enables it.
SEED_INGEST_ENABLED=false

# Set to false on staging before verification. This refuses every live-dataset
# mutation at the HTTP edge while still allowing explicitly enabled seed writes.
# Production behavior remains enabled unless this is deliberately changed.
LIVE_INGEST_ENABLED=true

# Returned by the API root so clients cannot mistake staging for production.
DEPLOYMENT_ENVIRONMENT=development

# Prometheus endpoint credential in username:password form. If absent, the
# endpoint answers 404. Supply this from a secret store, never from this file.
METRICS_BASIC_AUTH=

# Read for one purpose only: `production` together with SEED_INGEST_ENABLED=true
# is refused at startup. Nothing else branches on it.
NODE_ENV=development

# Requests per window per address against /v1/registry — the only surface with
# no authenticated caller behind it (docs/decisions/0024). The rows are
# immutable and served with a day-long Cache-Control, so a consumer that caches
# will never see this. Counted in this process, so it is per replica and resets
# on deploy: a real limit belongs at the gateway.
REGISTRY_RATE_LIMIT=600
REGISTRY_RATE_WINDOW_SECONDS=60

# Where the audit log is copied to, off this box (docs/decisions/0025). The
# database copy is the statutory record and is written synchronously; this is
# the tamper-evidence copy, and its value is that it sits somewhere an operator
# with credentials to this database cannot reach. Empty means it is not copied
# anywhere, which is a supported configuration and a weaker one.
#
# Shipping is best effort by design and can never fail a request. AUDIT_SHIP_TOKEN
# is a secret: set it in the environment, never here.
AUDIT_SHIP_URL=
AUDIT_SHIP_TOKEN=
AUDIT_SHIP_INTERVAL_SECONDS=10
AUDIT_SHIP_BATCH=200

# The whole s.9 question, as one boolean (docs/decisions/0029-consent.md).
#
# s.9(1) makes financial information special personal data. s.9(3)(c) exempts a
# body relating to individuals who are its members, provided nothing goes to a
# third party without consent. Whether that reaches a cooperative processing its
# members' prices is a question for counsel.
#
# true  — member-body access to a priced Delivery, Obligation or
#         SettlementReference additionally requires a consent grant.
# false — membership alone suffices.
#
# FAIL CLOSED. Leave it true until there is a written answer. Non-financial
# records are unaffected either way.
S9_CONSENT_REQUIRED_FOR_MEMBER_BODY=true

PORT=3000
LOG_LEVEL=info

# The training path's own role (migration 0028). SELECT on facts.record and no
# privileges at all on the inference schema, so a query that names a prediction
# fails with "permission denied for schema inference" before it returns a row.
# The requirement is that training *cannot* read inferences, not that it must
# remember to filter them out — a filter that can be forgotten will be.
#
# Leave TRAINING_DATABASE_URL empty where no training path runs. The queries
# are then simply unavailable, which is the safe direction to fail in.
KERNEL_TRAINING_PASSWORD=kernel_training_dev_only
TRAINING_DATABASE_URL=postgres://kernel_training:kernel_training_dev_only@localhost:5433/clycites

# The object store (work order H). S3 API only, so the backend stays
# swappable: this is MinIO in development, and the kernel neither knows nor
# cares in production. The image is pinned to the last release its owner
# published — read docs/decisions/0040-minio.md, which records the reversal of
# 0037 and the patch-path risk that came with it.
#
# The bucket is private, and under MinIO that is asserted rather than
# structural: compose runs `mc anonymous set none` because this server does
# have a public-policy setting to get wrong.
# Leave these empty where no media path runs: the endpoints answer 503, which
# is the safe direction to fail in.
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_BUCKET=clycites-media
# MinIO does not validate the region unless MINIO_REGION is set, so this is a
# label for the signature and nothing more.
MEDIA_S3_REGION=minio
MEDIA_S3_PATH_STYLE=true
MEDIA_S3_ACCESS_KEY=clycites_media_dev_only
MEDIA_S3_SECRET_KEY=clycites_media_dev_only_secret

# Anchoring. One Merkle root a day, published to a Hedera consensus topic.
#
# Leave the three credentials empty and the kernel never publishes: records are
# still batched and rooted locally the moment credentials appear, so nothing is
# lost by running without them.
#
# Only `live` data is ever anchored, enforced by a CHECK, a trigger and a query
# filter. Anchoring seed data would publish fabricated farmer records to a
# public ledger, permanently — the one failure in this system that cannot be
# undone.
#
# Testnet until field validation is done. Mainnet additionally requires
# ANCHOR_MAINNET_ACKNOWLEDGED set to the exact sentence in
# src/anchoring/anchor.module.ts, because it should take more than editing one
# word to make somebody else's farm records permanent.
ANCHOR_NETWORK=testnet
ANCHOR_TOPIC_ID=
ANCHOR_OPERATOR_ID=
ANCHOR_OPERATOR_KEY=
ANCHOR_MAINNET_ACKNOWLEDGED=
